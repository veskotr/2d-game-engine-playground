{
    // Terminal → Run Task… lists everything below. Ctrl+Shift+B runs "Engine: Build Debug".
    // Engine tasks need CMake + Visual Studio 2022; editor tasks need JDK 21 (see tools/editor/find-jdk.ps1).
    // Full Windows editor package: run "Editor: Package Windows App" (builds everything it needs).
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
    },
    "tasks": [
        // ---------------------------------------------------------------- Engine (C++)
        {
            "label": "Engine: Configure Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--preset", "debug", "-DSLE_BUILD_EDITOR=ON"],
            "problemMatcher": [],
            "detail": "Generate build/debug (Visual Studio 2022) with the editor bridge enabled."
        },
        {
            "label": "Engine: Configure Release",
            "type": "process",
            "command": "cmake",
            "args": ["--preset", "release", "-DSLE_BUILD_EDITOR=ON"],
            "problemMatcher": [],
            "detail": "Generate build/release with the editor bridge enabled."
        },
        {
            "label": "Engine: Build Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "build/debug", "--config", "Debug", "--parallel"],
            "dependsOn": ["Engine: Configure Debug"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$msCompile"],
            "detail": "Engine, examples, engine_app, tests and the Debug editor bridge."
        },
        {
            "label": "Engine: Build Release",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "build/release", "--config", "Release", "--parallel"],
            "dependsOn": ["Engine: Configure Release"],
            "group": "build",
            "problemMatcher": ["$msCompile"],
            "detail": "Everything in Release."
        },
        {
            "label": "Engine: Clean Rebuild Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "build/debug", "--config", "Debug", "--parallel", "--clean-first"],
            "dependsOn": ["Engine: Configure Debug"],
            "group": "build",
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Engine: Run All Tests",
            "type": "process",
            "command": "ctest",
            "args": ["--test-dir", "build/debug", "-C", "Debug", "--output-on-failure"],
            "dependsOn": ["Engine: Build Debug"],
            "group": "test",
            "problemMatcher": [],
            "detail": "Every CTest test, including windowed ones."
        },
        {
            "label": "Engine: Run Smoke Tests",
            "type": "process",
            "command": "ctest",
            "args": ["--test-dir", "build/debug", "-C", "Debug", "-L", "smoke", "--output-on-failure"],
            "dependsOn": ["Engine: Build Debug"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Engine: Run Tests Matching…",
            "type": "process",
            "command": "ctest",
            "args": ["--test-dir", "build/debug", "-C", "Debug", "-R", "${input:testRegex}", "--output-on-failure"],
            "group": "test",
            "problemMatcher": [],
            "detail": "Runs the CTest tests whose names match a regex (build first)."
        },
        {
            "label": "Engine: Run engine_app (engine.json)",
            "type": "process",
            "command": "${workspaceFolder}/build/debug/engine_app/Debug/engine_app.exe",
            "dependsOn": ["Engine: Build Debug"],
            "problemMatcher": [],
            "detail": "Debug engine with the repository's engine.json."
        },
        {
            "label": "Engine: Run Project…",
            "type": "process",
            "command": "${workspaceFolder}/build/debug/engine_app/Debug/engine_app.exe",
            "args": ["--project", "${input:projectFile}"],
            "dependsOn": ["Engine: Build Debug"],
            "problemMatcher": [],
            "detail": "Debug engine running a .sleproject folder project."
        },
        {
            "label": "Engine: Run Built Game Config…",
            "type": "process",
            "command": "${workspaceFolder}/build/debug/engine_app/Debug/engine_app.exe",
            "args": ["--config", "${input:gameConfig}"],
            "dependsOn": ["Engine: Build Debug"],
            "problemMatcher": [],
            "detail": "Debug engine running a built game's config.json and .slepkg packages."
        },

        // ---------------------------------------------------------------- Game runtime
        {
            "label": "Game: Build Runtime Bundle (Release)",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "build/release", "--config", "Release", "--target", "sle_runtime_bundle", "--parallel"],
            "dependsOn": ["Engine: Configure Release"],
            "group": "build",
            "problemMatcher": ["$msCompile"],
            "detail": "Prebuilt engine exe + DLLs + engine assets → build/release/runtime/Release (shipped inside the packaged editor)."
        },
        {
            "label": "Game: Run Built Game…",
            "type": "process",
            "command": "${input:gameExe}",
            "options": { "cwd": "${env:TEMP}" },
            "problemMatcher": [],
            "detail": "Runs an internal package build output (e.g. My Game.exe) from an unrelated folder, as a player would."
        },

        // ---------------------------------------------------------------- Editor (Kotlin)
        {
            "label": "Editor: Run",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/editor/run-editor.ps1"],
            "problemMatcher": [],
            "presentation": { "panel": "dedicated" },
            "detail": "Builds the Debug editor bridge and starts the editor with JDK 21 (gradle run)."
        },
        {
            "label": "Editor: Run Tests",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/editor/gradle.ps1", "build"],
            "group": "test",
            "problemMatcher": [],
            "detail": "Compiles the editor and runs its unit tests (gradle build)."
        },
        {
            "label": "Editor: Build Release Engine Library",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "build/release", "--config", "Release", "--target", "sle_editor_native", "--parallel"],
            "dependsOn": ["Engine: Configure Release"],
            "group": "build",
            "problemMatcher": ["$msCompile"],
            "detail": "build/release/tools/editor-native/Release/sle_editor_native.dll for packaging."
        },
        {
            "label": "Editor: Package Windows App",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/editor/gradle.ps1", "createDistributable"],
            "dependsOrder": "sequence",
            "dependsOn": ["Editor: Build Release Engine Library", "Game: Build Runtime Bundle (Release)"],
            "group": "build",
            "problemMatcher": [],
            "detail": "Runnable folder: tools/editor/build/compose/binaries/main/app/SLE Editor/SLE Editor.exe"
        },
        {
            "label": "Editor: Package Installers (MSI/EXE)",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/editor/gradle.ps1", "packageDistributionForCurrentOS"],
            "dependsOrder": "sequence",
            "dependsOn": ["Editor: Build Release Engine Library", "Game: Build Runtime Bundle (Release)"],
            "group": "build",
            "problemMatcher": [],
            "detail": "Installers in tools/editor/build/compose/binaries/main/{msi,exe} (Gradle downloads WiX)."
        },
        {
            "label": "Editor: Run Packaged App",
            "type": "process",
            "command": "${workspaceFolder}/tools/editor/build/compose/binaries/main/app/SLE Editor/SLE Editor.exe",
            "options": { "cwd": "${env:USERPROFILE}" },
            "problemMatcher": [],
            "detail": "Starts the packaged editor (run Editor: Package Windows App first)."
        }
    ],
    "inputs": [
        {
            "id": "projectFile",
            "type": "promptString",
            "description": "Path to the .sleproject file",
            "default": "C:/Games/My Game/My Game.sleproject"
        },
        {
            "id": "gameConfig",
            "type": "promptString",
            "description": "Path to a built game's config.json",
            "default": "C:/Games/Game Build/config.json"
        },
        {
            "id": "gameExe",
            "type": "promptString",
            "description": "Path to a built game executable",
            "default": "C:/Games/Game Build/My Game.exe"
        },
        {
            "id": "testRegex",
            "type": "promptString",
            "description": "CTest name regex",
            "default": "^integration_game_package_path$"
        }
    ]
}
