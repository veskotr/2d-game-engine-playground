cmake_minimum_required(VERSION 3.20)
if(POLICY CMP0207)
    cmake_policy(SET CMP0207 NEW)
endif()
# Run by sle_runtime_bundle after building engine_app. Only Release may be delivered.
if(NOT CONFIGURATION STREQUAL "Release")
    message(FATAL_ERROR "Runtime distribution requires a Release build")
endif()
if(NOT EXISTS "${ENGINE_APP}" OR NOT ENGINE_VERSION)
    message(FATAL_ERROR "Missing runtime executable or engine version")
endif()

if(RUNTIME_PLATFORM STREQUAL "windows-x64")
    if(NOT MSVC_RUNTIME_FILES)
        message(FATAL_ERROR "Missing MSVC Release redistributables")
    endif()
    set(executable "engine_app.exe")
    set(platform_label "Windows x64")
    set(game_setup "Build a saved project with File > Build Game (config.json + game.slepkg)\nor File > Export Game (game/game.sleproject folder) in SLE Editor.")
    set(requirements "Requires Windows 10 or later and a compatible OpenGL driver.")
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "windows+pe")
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL "dumpbin")
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${DUMPBIN}")
    file(GET_RUNTIME_DEPENDENCIES
        EXECUTABLES "${ENGINE_APP}"
        RESOLVED_DEPENDENCIES_VAR dependencies
        UNRESOLVED_DEPENDENCIES_VAR unresolved
        PRE_EXCLUDE_REGEXES "api-ms-.*" "ext-ms-.*"
        POST_EXCLUDE_REGEXES ".*[Ww]indows[/\\\\].*")
    if(unresolved)
        message(FATAL_ERROR "Unresolved runtime dependencies: ${unresolved}")
    endif()
    set(private_libraries ${MSVC_RUNTIME_FILES} ${dependencies})
elseif(RUNTIME_PLATFORM STREQUAL "linux-x64")
    set(executable "engine_app")
    set(platform_label "Linux x64")
    set(game_setup "Place an existing config.json and its .slepkg files beside engine_app,\nor place a project and its assets under game/ with the descriptor at game/game.sleproject.")
    set(requirements "Requires a compatible glibc and C++ runtime, an X11 or Wayland desktop, and an OpenGL 4.6 driver. Graphics and audio libraries are provided by the host.")

    # Engine dependencies are statically linked in the Linux Release preset.
    # Reject accidental shared dependencies so the bundle never relies on a build-tree .so.
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env LC_ALL=C "${OBJDUMP}" -p "${ENGINE_APP}"
        RESULT_VARIABLE result OUTPUT_VARIABLE elf ERROR_VARIABLE errors)
    if(NOT "${result}" STREQUAL "0" OR NOT elf MATCHES "file format elf64-x86-64")
        message(FATAL_ERROR "Could not inspect the Linux x64 runtime: ${result}: ${elf}${errors}")
    endif()
    string(REGEX MATCHALL "NEEDED[ \t]+[^ \t\r\n]+" needed "${elf}")
    foreach(entry IN LISTS needed)
        string(REGEX REPLACE "^NEEDED[ \t]+" "" library "${entry}")
        if(NOT library MATCHES "^lib(c|m|pthread|dl|rt|gcc_s|stdc\\+\\+|GL|OpenGL|GLX|EGL)\\.so\\.[0-9]+$" AND
           NOT library STREQUAL "ld-linux-x86-64.so.2")
            message(FATAL_ERROR "Unexpected shared library in Linux runtime: ${library}")
        endif()
    endforeach()
else()
    message(FATAL_ERROR "Unsupported runtime bundle platform: ${RUNTIME_PLATFORM}")
endif()

set(stage "${OUTPUT_DIRECTORY}.staging")
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}/notices")
file(COPY "${ENGINE_APP}" ${private_libraries} DESTINATION "${stage}")
foreach(folder IN ITEMS shaders ui fonts)
    file(COPY "${SOURCE_ROOT}/assets/${folder}" DESTINATION "${stage}/assets")
endforeach()
# Preserve dependency license notices, including bundled data/generator dependencies.
file(GLOB dependency_roots "${DEPENDENCY_ROOT}/*-src")
foreach(root IN LISTS dependency_roots)
    get_filename_component(name "${root}" NAME)
    file(GLOB notices "${root}/LICENSE*" "${root}/COPYING*" "${root}/COPYRIGHT*" "${root}/copying*")
    if(RUNTIME_PLATFORM STREQUAL "linux-x64" AND name STREQUAL "lua-src")
        list(APPEND notices "${root}/LUA_LICENSE")
    endif()
    if(notices)
        file(MAKE_DIRECTORY "${stage}/notices/${name}")
        file(COPY ${notices} DESTINATION "${stage}/notices/${name}")
    endif()
endforeach()
# GLM keeps its notice in copying.txt; font licensing remains with the source assets.
file(WRITE "${stage}/RUNNING.txt" "SLE engine ${ENGINE_VERSION} ${platform_label} Release runtime\n${game_setup}\n${executable} starts the game delivered beside it.\n${requirements}\nDependency notices are included in notices/.\n")
set(manifest "{\"format\":\"sle-runtime\",\"version\":1,\"engineVersion\":\"${ENGINE_VERSION}\",\"platform\":\"${RUNTIME_PLATFORM}\",\"configuration\":\"Release\",\"executable\":\"${executable}\",\"files\":{}}")
file(GLOB_RECURSE bundle_files LIST_DIRECTORIES FALSE RELATIVE "${stage}" "${stage}/*")
foreach(path IN LISTS bundle_files)
    file(SHA256 "${stage}/${path}" digest)
    string(JSON manifest SET "${manifest}" files "${path}" "\"${digest}\"")
endforeach()
file(WRITE "${stage}/sle-runtime.json" "${manifest}\n")
file(REMOVE_RECURSE "${OUTPUT_DIRECTORY}")
file(RENAME "${stage}" "${OUTPUT_DIRECTORY}")
message(STATUS "SLE runtime bundle: ${OUTPUT_DIRECTORY}")
